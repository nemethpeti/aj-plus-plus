{
  "manifest_version": 3,
  "name": "AJ++",
  "version": "0.2.0",
  "description": "Adds missing features to the AJ Investment Research dashboard: sort by ranking, sort by upside potential, and hide the announcement banner.",
  "content_scripts": [
    {
      "matches": ["https://consolidated.ajinvestmentresearch.com/*"],
      "all_frames": true,
      "js": ["dashboard-sort.js"],
      "css": ["dashboard-sort.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.ajinvestmentresearch.com/*",
        "https://ajinvestmentresearch.com/*"
      ],
      "css": ["hide-announcement-bar.css"],
      "run_at": "document_start"
    }
  ]
}
